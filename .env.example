# Copy to .env for normal SDK use, or .env.sandbox for live verification.
ADDEPAR_ENVIRONMENT=sandbox
ADDEPAR_FIRM_NAME=yourfirm
ADDEPAR_FIRM_ID=12345
# Existing Basic auth: base64(key_id:key_secret), NOT a bearer token.
ADDEPAR_API_KEY=replace_with_base64_key_and_secret
# OAuth alternative (choose ONE method):
# ADDEPAR_ACCESS_TOKEN=replace_with_oauth_access_token
# Optional full base URL, including /v1:
# ADDEPAR_BASE_URL=https://yourfirm.sandbox.addepar.com/api/v1
