# Copy to .env and load with AddePy.from_dotenv(".env").
# Use sandbox or development if provisioned for your firm.
ADDEPAR_ENVIRONMENT=production
ADDEPAR_FIRM_NAME=yourfirm
ADDEPAR_FIRM_ID=12345
ADDEPAR_KEY_ID=replace_with_key_id
ADDEPAR_KEY_SECRET=replace_with_key_secret
# Alternatives: remove BOTH key fields and use exactly one of these.
# ADDEPAR_API_KEY=replace_with_base64_encoded_key_id_colon_key_secret
# ADDEPAR_ACCESS_TOKEN=replace_with_oauth_access_token
# Optional API base URL overrides the firm hostname:
# ADDEPAR_BASE_URL=https://yourfirm.addepar.com/api/v1
# Values are literal; ${VARIABLE} interpolation is not performed.
