# Copy to your consuming Git repository's root .env for AddePy.from_dotenv().
# Or choose a file explicitly: AddePy.from_dotenv(".env.sandbox").
# Live verification always requires --env-file .env.sandbox.
# File values are literal; ${VARIABLE} interpolation is not performed.
ADDEPAR_ENVIRONMENT=sandbox
ADDEPAR_FIRM_NAME=yourfirm
ADDEPAR_FIRM_ID=12345
# Existing Basic auth: base64(key_id:key_secret), NOT a bearer token.
ADDEPAR_API_KEY=replace_with_base64_key_and_secret
# Choose exactly ONE authentication method; remove API_KEY for either alternative.
# Raw key pair alternative (both values required):
# ADDEPAR_KEY_ID=replace_with_key_id
# ADDEPAR_KEY_SECRET=replace_with_key_secret
# OAuth alternative:
# ADDEPAR_ACCESS_TOKEN=replace_with_oauth_access_token
# Optional full base URL, including /v1:
# ADDEPAR_BASE_URL=https://yourfirm.sandbox.addepar.com/api/v1
